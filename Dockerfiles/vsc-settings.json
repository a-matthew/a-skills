{
    "chat.disableAIFeatures": false,
    "chat.notifyWindowOnConfirmation": "always",
    "chat.editing.confirmEditRequestRemoval": true,
    "chat.editing.confirmEditRequestRetry": true,
    "chat.editing.autoAcceptDelay": 0,
    "chat.agent.enabled": true,
    "chat.subagents.allowInvocationsFromSubagents": false,
    "chat.subagents.defaultToAuto": false,
    "github.copilot.chat.searchSubagent.subagentSemanticSearchEnabled": true,
    "chat.agent.thinkingStyle": "fixedScrolling",
    "chat.mcp.access": false,
    "chat.mcp.discovery.enabled": false,
    "chat.tools.compressOutput.enabled": true,
    "chat.tools.terminal.autoReplyToPrompts": false,
    "chat.tools.riskAssessment.enabled": true,
    "chat.tools.terminal.autoApprove": {
        "rm": false,
        "rmdir": false,
        "del": false,
        "kill": false,
        "curl": false,
        "wget": false,
        "eval": false,
        "chmod": false,
        "chown": false,
        "/^Remove-Item\\b/i": false
    },
    "chat.tools.terminal.enableAutoApprove": false,
    "chat.tools.edits.autoApprove": {
        "**/*": false
    },
    "chat.tools.terminal.ignoreDefaultAutoApproveRules": false,
    "chat.tools.global.autoApprove": false,
    "chat.permissions.default": "default",
    "chat.autopilot.advanced.enabled": false,
    "github.copilot.chat.claudeAgent.allowDangerouslySkipPermissions": false,
    "chat.copilot.memory.enabled": true,
    "chat.copilot.memory.local.enabled": false,
    "chat.agentHost.claudeAgent.enabled": true,
    "chat.agentHost.codexAgent.enabled": false,
    "git.addAICoAuthor": "off",
    "chat.agentFilesLocations": {
        ".github/agents": true,
        ".claude/agents": true,
        "~/.copilot/agents": true
    },
    "chat.useAgentSkills": true,
    "chat.agentSkillsLocations": {
        ".agents/skills": true,
        ".github/skills": true,
        ".claude/skills": true,
        "~/.agents/skills": true,
        "~/.copilot/skills": true,
        "~/.claude/skills": true
    },
    "github.copilot.chat.otel.enabled": false,
    "github.copilot.chat.otel.captureContent": false,
    "github.copilot.chat.otel.captureIdentity": false,
    "agents.voice.enabled": true,
    "agents.voice.showButton": true,
    "agents.voice.speakResponses": false,
    "agents.voice.agentProgress": true,
    "agents.voice.voice": "birch_neutral",
    "agents.voice.language": "auto",
    "agents.voice.handsFree": false,
    "claudeCode.useTerminal": false,
    "claudeCode.initialPermissionMode": "default",
    "claudeCode.autosave": true,
    "claudeCode.hideOnboarding": true,
    "claudeCode.focusView": true,
    "claudeCode.respectGitIgnore": true,
    "claudeCode.allowDangerouslySkipPermissions": false
}